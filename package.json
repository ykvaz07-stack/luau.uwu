{
  "name": "scriptshield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:clyde && next build",
    "cf-build": "npm run build:clyde && next build && npx @opennextjs/cloudflare build",
    "build:clyde": "cd clyde && npm ci && npm run build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run cf-build && opennextjs-cloudflare deploy",
    "preview": "npm run cf-build && opennextjs-cloudflare preview",
    "pages:preview": "npm run cf-build && npx wrangler dev",
    "pages:deploy": "npm run cf-build && npx wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.110.2",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-mode-luau": "^1.0.9",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.112.0"
  }
}